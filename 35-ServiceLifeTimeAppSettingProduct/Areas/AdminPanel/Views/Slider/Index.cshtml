@using _34_Front_To_BackSqlConnection.Models
@model List<SliderGetVM>

@{
    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Slider</h4>
                <p class="card-description">
                    <a asp-action="Create" class="btn btn-success">Create</a>
                </p>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    №
                                </th>
                                <th>
                                    Image
                                </th>
                                <th>
                                    Title
                                </th>
                                <th>
                                    Order
                                </th>
                                <th>
                                    Settings
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var slider in Model)
                            {
                                count++;

                                <tr>
                                    <td>
                                        @count
                                    </td>
                                    <td>
                                        <img style="width:70px;height: 70px " src="~/assets/images/website-images/@slider.ImageURL" alt="Alternate Text" />
                                    </td>
                                    
                                    <td>
                                        <p>@slider.Title</p>
                                    </td>
                                    <td>
                                        <p>@slider.Order</p>
                                    </td>
                                    <td>
                                        <a class="btn btn-warning" asp-action="Update" asp-route-id="@slider.Id"><i class="mdi mdi-pencil-box"></i></a>
                                        <a class="btn btn-danger" asp-action="delete" asp-route-id="@slider.Id"><i class="mdi mdi-delete-forever"></i></a>
                                        <a class="btn btn-primary" asp-action="details" asp-route-id="@slider.Id"><i class="mdi mdi-information" "></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>