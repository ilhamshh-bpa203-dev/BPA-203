@model DetailsCategoryVM

@{
    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Details Category</h4>
                <p class="card-description">
                    <a asp-action="Create" class="btn btn-success">Create</a>
                </p>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    №
                                </th>
                                <th>
                                    Name
                                </th>
                                <th>
                                    Count
                                </th>
                                <th>
                                    Settings
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                      

                            @{
                                count++;
                            }

                            <tr>
                                <td>
                                    @count
                                </td>
                                <td>
                                    @Model.Name
                                </td>
                                <td>
                                    @Model.ProductCount
                                </td>
                                <td>
                                    <a class="btn btn-warning" asp-action="Update" asp-route-id="@Model.Id"><i class="mdi mdi-pencil-box"></i></a>
                                    <a class="btn btn-danger" asp-action="delete" asp-route-id="@Model.Id"><i class="mdi mdi-delete-forever"></i></a>
                                    @* <a class="btn btn-primary" asp-action="Details" asp-route-id="@Model.Id"><i class="mdi mdi-information"></i>  </a> *@

                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>