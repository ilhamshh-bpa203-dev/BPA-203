@using _34_Front_To_BackSqlConnection.Models
@model UpdateProductVM
@{
    ProductImage mainImage = Model.ProductImages.FirstOrDefault(pi => pi.IsPrimary == true);
    ProductImage hoverImage = Model.ProductImages.FirstOrDefault(pi => pi.IsPrimary == true);
}

<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Update Product</h4>

                <form class="forms-sampless" method="post" enctype="multipart/form-data">
                    <img style="width:150px;height:150px" src="~/assets/images/website-images/@mainImage.ImageURL" alt="Alternate Text" />

                    <div class="form-group">
                        <label for="MainPhoto">Main Image</label>
                        <input asp-for="MainPhoto" class="form-control" accept="image/*">
                        <span class="text-danger" asp-validation-for="MainPhoto"></span>
                    </div>

                    <img style="width:150px;height:150px" src="~/assets/images/website-images/@hoverImage.ImageURL" alt="Alternate Text" />

                    <div class="form-group">
                        <label for="HoverPhoto">Secon Image</label>
                        <input asp-for="HoverPhoto" class="form-control" accept="image/*">
                        <span class="text-danger" asp-validation-for="HoverPhoto"></span>
                    </div>

                    <div>
                        @foreach (var item in Model.ProductImages.Where(pi=>pi.IsPrimary==null).ToList())
                        {
                           <div class="position-relative">
                                <img style="width:150px;height:150px" src="~/assets/images/website-images/@item.ImageURL" alt="Alternate Text" />
                                <i class="cust_btn mdi mdi-close-circle" style="cursor:pointer;position:absolute;top:10px;right:10px"></i>
                                <input asp-for="ImageIds" type="hidden"  value="@item.Id" />
                           </div>
                        }
                    </div>
                    <div class="form-group">
                        <label for="AdditionalPhoto">Additional Image</label>
                        <input asp-for="AdditionalPhoto" class="form-control" placeholder="Image" accept="image/*">
                        <span class="text-danger" asp-validation-for="ImageIds"></span>
                    </div>


                    
                    <div class="form-group">
                        <label for="Name">Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Image" accept="image/*">
                        <span class="text-danger" asp-validation-for="Name"></span>
                    </div>
                    <div class="form-group">
                        <label for="Price">Price</label>
                        <input asp-for="Price" class="form-control" placeholder="Title">
                        <span class="text-danger" asp-validation-for="Price"></span>
                    </div>
                    <div class="form-group">
                        <label for="SKU">SKU</label>
                        <input asp-for="SKU" class="form-control" placeholder="SKU">
                        <span class="text-danger" asp-validation-for="SKU"></span>
                    </div>
                    <div class="form-group">
                        <label for="CategoryId">CategoryId</label>

                        <select asp-for="CategoryId" class="form-control" asp-items="new SelectList(Model.Categories, nameof(Category.Id), nameof(Category.Name))">
                            <option value="" selected disabled>Choose Category</option>
                        </select>
                        <span class="text-danger" asp-validation-for="CategoryId"></span>

                    </div>
                    <div class="form-group">
                        <label for="TagIds">TagIds</label>

                        <select asp-for="TagIds" class="form-control" asp-items="new SelectList(Model.Tags, nameof(Tag.Id), nameof(Tag.Name))">
                        </select>
                        <span class="text-danger" asp-validation-for="TagIds"></span>

                    </div>
                    <div class="form-group">
                        <label for="Description">Description</label>
                        <textarea asp-for="Description" class="form-control" placeholder="Description"></textarea>
                        <span class="text-danger" asp-validation-for="Description"></span>
                    </div>
                    <button type="submit" class="btn btn-primary me-2">Submit</button>
                    <button asp-action="Index" class="btn btn-light">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section DeleteBtn{
    <script>
        var btns = document.querySelectorAll(".cust_btn");
        for(let i = 0;i<btns.length;i++){
            btns[i].addEventListener("click" function (
                btns[i].parentElement.remove();
            )
        })

    </script>
}

